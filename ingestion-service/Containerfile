# Ingestion-palvelun Containerfile (FastAPI). Rakentaa kontin joka ottaa vastaan
# Orthancin webhookit ja luo QA-jobit tietokantaan.
FROM python:3.12-slim
WORKDIR /app

# Ei-root-käyttäjä (rootless Podman vaatii tämän).
RUN adduser --disabled-password --gecos '' --uid 1000 appuser

# Asennetaan Python-riippuvuudet ensin (välimuistittuu ellei requirements muutu).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopioidaan sovelluskoodi (app/-paketti: main, config, routes, services).
COPY app ./app

# Ajetaan ei-root-käyttäjänä; palvelu kuuntelee porttia 8000.
USER appuser
EXPOSE 8000

# Käynnistä FastAPI uvicorn-palvelimella, kuuntele kaikkia osoitteita portissa 8000.
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
