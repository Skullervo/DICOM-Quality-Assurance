# Kopioi tämä tiedosto nimelle .env ja täytä oikeat arvot (.env on gitignorattu).

# Tietokanta
DATABASE_NAME=QA-results
DATABASE_USER=postgres
DATABASE_PASSWORD=vaihda-tama       # PostgreSQL (legacy)
MSSQL_SA_PASSWORD=vaihda-tama       # MS SQL Server (sa)

# Orthanc DICOM -palvelin
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=vaihda-tama

# OpenAI (AI-assistentti)
OPENAI_API_KEY=sk-proj-...

# Slack-ilmoitukset
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
