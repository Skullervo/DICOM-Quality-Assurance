# Kopioi tämä tiedosto nimelle .env ja täytä oikeat arvot (.env on gitignorattu).

# Tietokanta
DATABASE_NAME=QA-results
DATABASE_USER=postgres
DATABASE_PASSWORD=vaihda-tama       # PostgreSQL (legacy)
MSSQL_SA_PASSWORD=vaihda-tama       # MS SQL Server (sa)

# Orthanc DICOM -palvelin
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=vaihda-tama

# OpenAI (AI-assistentti)
OPENAI_API_KEY=sk-proj-...

# Slack-ilmoitukset
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# S3 / SeaweedFS object storage (US + angio analysis images)
S3_ENDPOINT=http://object-storage:8333
S3_BUCKET=qa-outputs
S3_ACCESS_KEY=autoqadaccess
S3_SECRET_KEY=vaihda-tama-s3-secret

# ── Host-portit ───────────────────────────────────────────────────────────
# Portit jotka Podman julkaisee isäntäkoneelle. Vaihda VAIN jos jokin on jo
# varattuna koneellasi (yleisin törmäys: 8080). Muuta vain vasemmanpuoleista
# numeroa — konttien sisäiset portit ja konttien väliset osoitteet eivät muutu.
# Vapaan portin tarkistus:  Windows: netstat -ano | findstr :8080
#                           Linux:   ss -ltnp | grep 8080
MSSQL_HOST_PORT=11433          # MS SQL Server
ORTHANC_DICOM_HOST_PORT=14242  # Orthanc DICOM (C-STORE)
ORTHANC_REST_HOST_PORT=18042   # Orthanc REST / Explorer
INGESTION_HOST_PORT=8070       # Ingestion-palvelu
IMAGE_HOST_PORT=8090           # Kuvapalvelu
S3_HOST_PORT=8333              # SeaweedFS (S3)
GO_HOST_PORT=8081              # Go-backend (suora)
CADDY_HTTP_PORT=8080           # Caddy HTTP (selaimen pääsisäänkäynti)
CADDY_HTTPS_PORT=8443          # Caddy HTTPS
