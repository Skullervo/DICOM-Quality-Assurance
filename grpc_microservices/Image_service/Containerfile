FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --disabled-password --gecos '' --uid 1000 appuser

# Install Python deps
COPY grpc_microservices/Image_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy image service code (image-service on itsenäinen, ei riipu client/-Djangosta)
COPY grpc_microservices/Image_service/image_service.py .
COPY grpc_microservices/Image_service/us_crop.py .

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8090

CMD ["uvicorn", "image_service:app", "--host", "0.0.0.0", "--port", "8090"]
