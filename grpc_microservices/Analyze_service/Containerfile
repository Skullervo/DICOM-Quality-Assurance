# US-analyysipalvelun kontti (ultraääni). Sisältää sekä vanhan gRPC-pollerin
# (portti 50052) että event-driven-workerin. Metriikat portissa 9110 (Prometheus).
FROM python:3.12-slim
WORKDIR /app

# Järjestelmäkirjastot: libgl1 + libglib2.0-0 tarvitaan OpenCV:lle (kuvankäsittely),
# protobuf-compiler .proto-tiedostojen kääntämiseen. Apt-välimuisti poistetaan,
# ei-root-käyttäjä luodaan.
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    protobuf-compiler && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --disabled-password --gecos '' --uid 1000 appuser

# Asennetaan Python-riippuvuudet.
COPY requirements_service.txt .
RUN pip install --no-cache-dir -r requirements_service.txt

# Kopioidaan palvelukoodi: gRPC-palvelin, event-worker, S3-client, .proto-rajapinnat,
# US-analyysilogiikka (US_IQ_analysis3) ja anturi-LUT-taulukot (probe-LUT.xls).
COPY analyze_service_timed.py worker_us_eventdriven.py s3_client.py analyze_service_timed.proto fetch_service.proto US_IQ_analysis3.py LUT_table_codes.py LUT_taulukko_lisaa.py probe-LUT.xls ./

# Käännetään molemmat .proto-rajapinnat Python-stubeiksi.
RUN python -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. analyze_service_timed.proto fetch_service.proto

# Varmistetaan että ei-root-käyttäjä omistaa tiedostot, ja vaihdetaan siihen.
RUN chown -R appuser:appuser /app
USER appuser

# Portit: 50052 = gRPC-palvelu, 9110 = Prometheus-metriikat.
EXPOSE 50052 9110

# Oletuskäynnistys: gRPC-palvelin (poller). Event-workeri käynnistetään erikseen
# eri komennolla (ks. deployment / compose).
CMD ["python", "analyze_service_timed.py"]
