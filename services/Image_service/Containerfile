# Image Service -kontti: tarjoaa US-kuvien suoristuksen/rajauksen (FastAPI, portti 8090).
# HUOM: build-konteksti on projektin juuri (ks. start-podman.sh), siksi COPY-polut
# alkavat services/Image_service/... -muodossa.
FROM python:3.12-slim

WORKDIR /app

# libgl1 + libglib2.0-0 tarvitaan OpenCV:lle. Apt-välimuisti poistetaan, ei-root luodaan.
RUN apt-get update && \
    apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --disabled-password --gecos '' --uid 1000 appuser

# Install Python deps
# Asennetaan Python-riippuvuudet.
COPY services/Image_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy image service code (image-service on itsenäinen, ei riipu client/-Djangosta)
# Kopioidaan palvelukoodi (kuvapalvelin + US-rajaus).
COPY services/Image_service/image_service.py .
COPY services/Image_service/us_crop.py .

# Ei-root-käyttäjä omistaa tiedostot, ja vaihdetaan siihen.
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8090

# Käynnistä FastAPI uvicornilla portissa 8090.
CMD ["uvicorn", "image_service:app", "--host", "0.0.0.0", "--port", "8090"]
