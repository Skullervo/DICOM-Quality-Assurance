# CT-analyysipalvelun kontti (Catphan-fantomi, gRPC portti 50054).
FROM python:3.12-slim
WORKDIR /app

# Järjestelmäkirjastot: gcc + libpq-dev C-laajennosten käännökseen.
# Apt-välimuisti poistetaan, ei-root-käyttäjä luodaan.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --disabled-password --gecos '' --uid 1000 appuser

# Asennetaan Python-riippuvuudet (mm. pylinac CT-analyysiin).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopioidaan koko palvelun lähdekoodi.
COPY . .

# Käännetään gRPC-rajapinta Python-stubeiksi.
RUN python -m grpc_tools.protoc \
    -I. \
    --python_out=. \
    --grpc_python_out=. \
    ct_analyze_service.proto

# Ajetaan ei-root-käyttäjänä; palvelu kuuntelee porttia 50054.
USER appuser

EXPOSE 50054

CMD ["python", "ct_analyze_service.py"]
