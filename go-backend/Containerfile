# Go-backendin Containerfile (Podman, rootless). KOLMIVAIHEINEN build:
#   1) rakennetaan React-frontend Node-kuvassa,
#   2) käännetään Go-binääri,
#   3) kootaan kevyt ajokuva (binääri + valmis frontend).
#
# HUOM: build-konteksti on PROJEKTIN JUURI (ei go-backend/), jotta frontend-lähde on
# saatavilla samassa buildissa. Näin puhdas klooni asentuu ilman käsin ajettua
# "npm run build" -askelta. start-podman.sh ajaa:
#   podman build -f go-backend/Containerfile \
#     --ignorefile go-backend/.containerignore  <projektin juuri>
# (.containerignore rajaa kontekstin vain go-backend/- ja frontend/-lähteisiin.)

# --- Vaihe 1: React-frontendin build ---
# Node-kuva vain kääntämistä varten; ei päädy lopulliseen imageen.
FROM docker.io/library/node:20-alpine AS frontend
WORKDIR /frontend
# Kopioidaan ensin lukkotiedostot -> npm ci välimuistittuu kunnes riippuvuudet muuttuvat.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
# Loput frontend-lähteestä ja tuotantobuild (tsc + vite) -> /frontend/dist.
COPY frontend/ ./
RUN npm run build

# --- Vaihe 2: Go-binäärin käännös ---
# Go-työkalut sisältävä välikuva; vain valmis binääri otetaan mukaan.
FROM docker.io/library/golang:1.26-alpine AS builder
WORKDIR /build
# Riippuvuudet ensin -> välimuistittuu kunnes go.mod/go.sum muuttuu.
COPY go-backend/go.mod go-backend/go.sum ./
RUN go mod download
# Go-lähde ja staattinen binääri (CGO_ENABLED=0 -> toimii minimaalisessa Alpinessa).
COPY go-backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o autoqad-backend .

# --- Vaihe 3: ajokuva (runtime) ---
# Kevyt Alpine ilman Go-/Node-työkaluja; vain valmis binääri + rakennettu frontend.
FROM docker.io/library/alpine:3.21

# Ei-root-käyttäjä (uid 1000). Rootless Podman vaatii että prosessi EI aja roottina.
RUN addgroup -g 1000 -S autoqad && \
    adduser -u 1000 -S autoqad -G autoqad

WORKDIR /app
# Go-binääri + React-build (ServeReact tarjoilee ./frontend/dist tiedostojärjestelmästä).
COPY --from=builder  /build/autoqad-backend .
COPY --from=frontend /frontend/dist ./frontend/dist

USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["./autoqad-backend"]
