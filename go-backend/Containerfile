# Multi-stage build for rootless Podman
FROM docker.io/library/golang:1.26-alpine AS builder

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o autoqad-backend .

# Runtime — rootless, distroless-style
FROM docker.io/library/alpine:3.21

RUN addgroup -g 1000 -S autoqad && \
    adduser -u 1000 -S autoqad -G autoqad

WORKDIR /app
COPY --from=builder /build/autoqad-backend .

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["./autoqad-backend"]
