# AutoQAD Go Backend — Environment Variables
# Copy to .env and fill in values

# Server
GO_PORT=8080

# PostgreSQL (same DB as Django)
DATABASE_NAME=QA-results
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Orthanc DICOM server
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=admin
ORTHANC_PASSWORD=

# JWT secret (for future auth)
JWT_SECRET=

# OpenAI (for AI assistant)
OPENAI_API_KEY=

# Slack webhook (for issue reporting). Modality-specific override the generic one.
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_US=
SLACK_WEBHOOK_CT=
SLACK_WEBHOOK_XR=

# S3-compatible object storage (SeaweedFS/MinIO/any). Analysis images.
S3_ENDPOINT=http://object-storage:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=qa-outputs
S3_REGION=us-east-1
