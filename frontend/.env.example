# Frontendin ympäristömuuttujat (Vite). Kopioi -> .env.local ja muokkaa.

# API-osoite (dev-proxy hoitaa oletuksena /Laadunhallinta/api -> localhost:8081)
# VITE_API_BASE=/Laadunhallinta/api

# Kevyen kirjautumisportin tunnukset (frontend-only gate).
# HUOM: nämä päätyvät selaimen bundleen — EI oikeaa tietoturvaa, vain UI-portti.
# Oletukset jos ei asetettu: admin / viroviusqa
VITE_LOGIN_USER=admin
VITE_LOGIN_PASSWORD=viroviusqa
